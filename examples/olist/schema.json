{
  "name": "olist",
  "root": "../../../PITFALL_olist_data",
  "tables": {
    "orders": {
      "path": "olist_orders_dataset.csv",
      "time": "order_purchase_timestamp",
      "parse_dates": ["order_purchase_timestamp", "order_approved_at", "order_delivered_carrier_date",
                      "order_delivered_customer_date", "order_estimated_delivery_date"],
      "self_available": ["order_approved_at", "order_delivered_carrier_date",
                         "order_delivered_customer_date"],
      "unknown": ["order_status"],
      "keys": ["order_id", "customer_id"]
    },
    "order_items": {
      "path": "olist_order_items_dataset.csv",
      "parse_dates": ["shipping_limit_date"],
      "time_from": {"table": "orders", "key": "order_id", "column": "ts"},
      "keys": ["order_id", "order_item_id", "product_id", "seller_id"]
    },
    "reviews": {
      "path": "olist_order_reviews_dataset.csv",
      "time": "review_creation_date",
      "parse_dates": ["review_creation_date", "review_answer_timestamp"],
      "self_available": ["review_answer_timestamp"],
      "keys": ["review_id", "order_id"]
    },
    "payments": {
      "path": "olist_order_payments_dataset.csv",
      "time_from": {"table": "orders", "key": "order_id", "column": "ts"},
      "keys": ["order_id", "payment_sequential"]
    }
  },
  "entities": {
    "product": {"table": "order_items", "key": "product_id",
                "seen_in": {"table": "order_items", "column": "product_id"}}
  }
}
